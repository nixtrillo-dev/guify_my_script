{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RootGUIConfig",
  "description": "JSON schema for guify_my_script configuration payload.",
  "type": "object",
  "defaultSnippets": [
    {
      "label": "New Root GUI Config Boilerplate",
      "description": "Scaffolds a complete config file with default settings.",
      "body": {
        "config": {
          "title": "${1:App Title}",
          "icon": "/home/$USER/Pictures/Icons/gms/com.nixtrillo.gms.png",
          "uuid": "com.$USER.${2:uuid}",
          "script_alias": "${3:script_name}",
          "source_script_amd64": "${4:/path/to/script_amd64}",
          "source_script_arm64": "${5:/path/to/script_arm64}",
          "source_type": "${6|go,bash,python,javascript,powershell,rust|}",
          "startup": "tray",
          "tray_on_minimize": true,
          "instance_mode": "replace",
          "action_on_startup": null,
          "default_tab_on_startup": null,
          "close_after_startup_action": false,
          "sudo": false,
          "theme": {
            "color": "auto",
            "width": 600,
            "height": 400
          }
        },
        "main_menu": {
          "tab_label": "Main Menu",
          "welcome_heading_label": null,
          "info_label": null
        },
        "deploy": {
          "description": "Generated Qt GUI package staged by guify_my_script.",
          "version": "0.0.1",
          "release_number": "1",
          "summary": "A GUI frontend for executing commands for ${3:script}",
          "license": "MIT",
          "maintainer": "gms",
          "support_email": "maintainer@example.invalid",
          "dependencies": [
            {
              "pacman": [],
              "arch": [],
              "apt": [],
              "debian": [],
              "dnf": [],
              "fedora": []
            }
          ]
        },
        "actions": []
      }
    }
  ],
  "required": [
    "config",
    "main_menu",
    "deploy",
    "actions"
  ],
  "properties": {
    "config": {
      "$ref": "#/$defs/uiConfig"
    },
    "main_menu": {
      "$ref": "#/$defs/mainMenuConfig"
    },
    "deploy": {
      "$ref": "#/$defs/deployConfig"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uiAction"
      }
    }
  },
  "$defs": {
    "uiConfig": {
      "type": "object",
      "defaultSnippets": [
        {
          "label": "New UIConfig Boilerplate",
          "body": {
            "title": "${1:App Title}",
            "icon": "/home/$USER/Pictures/Icons/gms/com.nixtrillo.gms.png",
            "uuid": "com.$USER.${2:uuid}",
            "script_alias": "${3:script_name}",
            "source_script_amd64": "${4:/path/to/script_amd64}",
            "source_script_arm64": "${5:/path/to/script_arm64}",
            "source_type": "${6|go,bash,python,javascript,powershell,rust|}",
            "startup": "tray",
            "tray_on_minimize": true,
            "instance_mode": "replace",
            "action_on_startup": null,
            "default_tab_on_startup": null,
            "close_after_startup_action": false,
            "sudo": false,
            "theme": {
              "color": "auto",
              "width": 600,
              "height": 400
            }
          }
        }
      ],
      "required": [
        "title",
        "icon",
        "uuid",
        "script_alias",
        "source_script_amd64",
        "source_script_arm64",
        "source_type",
        "startup",
        "tray_on_minimize",
        "instance_mode",
        "close_after_startup_action",
        "sudo",
        "theme"
      ],
      "properties": {
        "title": { "type": "string" },
        "icon": { "type": "string" },
        "uuid": { "type": "string" },
        "script_alias": { "type": "string" },
        "source_script_amd64": { "type": "string" },
        "source_script_arm64": { "type": "string" },
        "source_type": {
          "type": "string",
          "enum": ["go", "bash", "python", "javascript", "powershell", "rust"]
        },
        "startup": { "type": "string" },
        "tray_on_minimize": { "type": "boolean" },
        "instance_mode": { "type": "string" },
        "action_on_startup": { "type": ["string", "null"] },
        "default_tab_on_startup": { "type": ["string", "null"] },
        "close_after_startup_action": { "type": "boolean" },
        "sudo": { "type": "boolean" },
        "theme": {
          "type": "object",
          "required": ["color", "width", "height"],
          "properties": {
            "color": { "type": "string" },
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        }
      }
    },
    "mainMenuConfig": {
      "type": "object",
      "defaultSnippets": [
        {
          "label": "New Main Menu Boilerplate",
          "body": {
            "tab_label": "Main Menu",
            "welcome_heading_label": null,
            "info_label": null
          }
        }
      ],
      "required": ["tab_label"],
      "properties": {
        "tab_label": { "type": "string" },
        "welcome_heading_label": { "type": ["string", "null"] },
        "info_label": { "type": ["string", "null"] }
      }
    },
    "deployConfig": {
      "type": "object",
      "defaultSnippets": [
        {
          "label": "New Deploy Boilerplate",
          "body": {
            "description": "Generated Qt GUI package staged by guify_my_script.",
            "version": "0.0.1",
            "release_number": "1",
            "summary": "A GUI frontend for executing commands for ${1:script}",
            "license": "MIT",
            "maintainer": "gms",
            "support_email": "maintainer@example.invalid",
            "dependencies": [
              {
                "pacman": [],
                "arch": [],
                "apt": [],
                "debian": [],
                "dnf": [],
                "fedora": []
              }
            ]
          }
        }
      ],
      "required": [
        "description",
        "version",
        "release_number",
        "summary",
        "license",
        "maintainer",
        "support_email",
        "dependencies"
      ],
      "properties": {
        "description": { "type": "string" },
        "version": { "type": "string" },
        "release_number": { "type": "string" },
        "summary": { "type": "string" },
        "license": { "type": "string" },
        "maintainer": { "type": "string" },
        "support_email": {
          "type": "string",
          "format": "email"
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/deployDependency" }
        }
      }
    },
    "deployDependency": {
      "type": "object",
      "properties": {
        "pacman": { "type": "array", "items": { "type": "string" } },
        "arch": { "type": "array", "items": { "type": "string" } },
        "apt": { "type": "array", "items": { "type": "string" } },
        "debian": { "type": "array", "items": { "type": "string" } },
        "dnf": { "type": "array", "items": { "type": "string" } },
        "fedora": { "type": "array", "items": { "type": "string" } }
      }
    },
    "uiAction": {
      "type": "object",
      "defaultSnippets": [
        {
          "label": "New UIAction Boilerplate",
          "body": {
            "label": "${1:Action Title}",
            "func": "${2:function_name}",
            "execution_mode": "GUI",
            "refresh_fields_on_tab_open": [],
            "refresh_fields_on_completion": [],
            "quick_launch": false,
            "width": 600,
            "sudo": false,
            "exec_label": "Execute ${1}",
            "exec_in_progress_label": "Executing ${1}...",
            "stop_label": "Stop",
            "fields": []
          }
        }
      ],
      "required": [
        "label",
        "func",
        "execution_mode",
        "quick_launch",
        "width",
        "sudo",
        "exec_label",
        "exec_in_progress_label",
        "stop_label",
        "fields"
      ],
      "properties": {
        "label": { "type": "string" },
        "func": { "type": "string" },
        "execution_mode": {
          "type": "string",
          "default": "GUI",
          "description": "Execution mode for this action. Accepted values: GUI (or g), GUI_COMMANDLINE (or gc), SILENT (or s), DETACHED_COMMANDLINE (or d), COMMANDLINE (or c). Case-insensitive.",
          "anyOf": [
            {
              "enum": [
                "GUI",
                "GUI_COMMANDLINE",
                "SILENT",
                "DETACHED_COMMANDLINE",
                "COMMANDLINE",
                "g",
                "gc",
                "s",
                "d",
                "c"
              ]
            },
            {
              "pattern": "^([gG][uU][iI]|[gG][uU][iI]_[cC][oO][mM][mM][aA][nN][dD][lL][iI][nN][eE]|[sS][iI][lL][eE][nN][tT]|[dD][eE][tT][aA][cC][hH][eE][dD]_[cC][oO][mM][mM][aA][nN][dD][lL][iI][nN][eE]|[cC][oO][mM][mM][aA][nN][dD][lL][iI][nN][eE]|[gG]|[gG][cC]|[sS]|[dD]|[cC])$"
            }
          ]
        },
        "mode": {
          "type": "string",
          "description": "Deprecated alias for execution_mode. Do not define both mode and execution_mode on the same action."
        },
        "refresh_fields_on_tab_open": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "refresh_fields_on_completion": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "quick_launch": { "type": "boolean" },
        "width": { "type": "integer" },
        "sudo": { "type": "boolean" },
        "exec_label": { "type": "string" },
        "exec_in_progress_label": { "type": "string" },
        "stop_label": { "type": "string" },
        "invoke_as_object": {
          "type": "boolean",
          "default": false,
          "description": "When true, all positional arguments are combined into a single JSON object {arg_name: value} instead of separate arguments."
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/uiField" }
        }
      }
    },
    "uiField": {
      "type": "object",
      "defaultSnippets": [
        {
          "label": "New TXT (Text) Field",
          "description": "Scaffolds a standard text input field.",
          "body": {
            "name": "${1:Text Input}",
            "field_type": "TXT",
            "data_type": "string",
            "default": "Initial Value",
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New DIR (Directory) Field",
          "description": "Scaffolds a directory picker field.",
          "body": {
            "name": "${1:Directory Picker}",
            "field_type": "DIR",
            "data_type": "string",
            "default": "/home",
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New FL (File) Picker Field",
          "description": "Scaffolds a single file picker field.",
          "body": {
            "name": "${1:File Picker}",
            "field_type": "FL",
            "data_type": "string",
            "default": "",
            "file_types": ["txt"],
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New MFL (Multi-File) Picker Field",
          "description": "Scaffolds a multi-file picker field.",
          "body": {
            "name": "${1:Multi-File Picker}",
            "field_type": "MFL",
            "data_type": "string",
            "default": "",
            "file_types": ["txt"],
            "minimum": null,
            "maximum": null,
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New FS (File Save) Picker Field",
          "description": "Scaffolds a save file picker field.",
          "body": {
            "name": "${1:Save File Picker}",
            "field_type": "FS",
            "data_type": "string",
            "default": "",
            "file_types": ["txt"],
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New CB (Combo Box) Field",
          "description": "Scaffolds a single-select dropdown field.",
          "body": {
            "name": "${1:Combo Box}",
            "field_type": "CB",
            "data_type": "string",
            "options": ["Option1", "Option2", "Option3"],
            "default": "Option1",
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New CK (Checkbox) Field",
          "description": "Scaffolds a boolean checkbox field.",
          "body": {
            "name": "${1:Checkbox}",
            "field_type": "CK",
            "data_type": "bool",
            "default": "0",
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New FD (File/Directory) Picker Field",
          "description": "Scaffolds a hybrid file or directory picker.",
          "body": {
            "name": "${1:File or Directory Picker}",
            "field_type": "FD",
            "data_type": "string",
            "default": "",
            "file_types": ["txt"],
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New MCB (Multi-Combo Box) Field",
          "description": "Scaffolds a multi-select dropdown field.",
          "body": {
            "name": "${1:Multi-Combo Box}",
            "field_type": "MCB",
            "data_type": "list",
            "options": ["Option1", "Option2", "Option3"],
            "default": ["Option2", "Option3"],
            "minimum": "0",
            "maximum": "0",
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New LTXT (Long Text) Field",
          "description": "Scaffolds a multi-line text area field.",
          "body": {
            "name": "${1:Long Text}",
            "field_type": "LTXT",
            "data_type": "string",
            "default": "Initial Long Text Value",
            "auto_height": true,
            "min_height": 240,
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New TIME Field",
          "description": "Scaffolds a time picker field.",
          "body": {
            "name": "${1:Time Picker}",
            "field_type": "TIME",
            "data_type": "string",
            "default": "12:00:00",
            "minimum": null,
            "maximum": null,
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New DATE Field",
          "description": "Scaffolds a date picker field.",
          "body": {
            "name": "${1:Date Picker}",
            "field_type": "DATE",
            "data_type": "string",
            "default": "2026-01-01",
            "minimum": null,
            "maximum": null,
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        },
        {
          "label": "New NUM (Number) Field",
          "description": "Scaffolds a numeric input field.",
          "body": {
            "name": "${1:Number Input}",
            "field_type": "NUM",
            "data_type": "int",
            "default": "0",
            "minimum": null,
            "maximum": null,
            "decimal_places": "0",
            "enabled": true,
            "advanced_menu": false,
            "json_endpoints": {
              "array_endpoint": [],
              "path_to_array": null,
              "get_defaults_endpoint": [],
              "path_to_default": null,
              "get_enabled_endpoint": [],
              "path_to_enabled": null
            },
            "refresh_fields_on_change": []
          }
        }
      ],
      "required": [
        "name",
        "data_type",
        "enabled",
        "advanced_menu",
        "json_endpoints",
        "refresh_fields_on_change"
      ],
      "anyOf": [
        { "required": ["field_type"] },
        { "required": ["type"] }
      ],
      "not": {
        "required": ["type", "field_type"]
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": ["field_type"],
                "properties": { "field_type": { "enum": ["CB", "MCB"] } }
              },
              {
                "required": ["type"],
                "properties": { "type": { "enum": ["CB", "MCB"] } }
              }
            ]
          },
          "then": {
            "required": ["options"]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": ["field_type"],
                "properties": { "field_type": { "enum": ["MCB", "MFL", "TIME", "DATE", "NUM"] } }
              },
              {
                "required": ["type"],
                "properties": { "type": { "enum": ["MCB", "MFL", "TIME", "DATE", "NUM"] } }
              }
            ]
          },
          "then": {
            "required": ["minimum", "maximum"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["minimum"] },
                { "required": ["maximum"] }
              ]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": ["field_type"],
                "properties": { "field_type": { "const": "NUM" } }
              },
              {
                "required": ["type"],
                "properties": { "type": { "const": "NUM" } }
              }
            ]
          },
          "then": {
            "required": ["decimal_places"],
            "properties": {
              "default": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              },
              "minimum": {
                "type": ["string", "null"],
                "pattern": "^-?\\d+(\\.\\d+)?$"
              },
              "maximum": {
                "type": ["string", "null"],
                "pattern": "^-?\\d+(\\.\\d+)?$"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": ["field_type"],
                "properties": { "field_type": { "const": "MCB" } }
              },
              {
                "required": ["type"],
                "properties": { "type": { "const": "MCB" } }
              }
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "minimum": {
                "type": ["string", "null"],
                "pattern": "^\\d+$"
              },
              "maximum": {
                "type": ["string", "null"],
                "pattern": "^\\d+$"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": ["field_type"],
                "properties": { "field_type": { "const": "MFL" } }
              },
              {
                "required": ["type"],
                "properties": { "type": { "const": "MFL" } }
              }
            ]
          },
          "then": {
            "properties": {
              "minimum": {
                "type": ["string", "null"],
                "pattern": "^\\d+$"
              },
              "maximum": {
                "type": ["string", "null"],
                "pattern": "^\\d+$"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": ["field_type"],
                "properties": { "field_type": { "const": "DATE" } }
              },
              {
                "required": ["type"],
                "properties": { "type": { "const": "DATE" } }
              }
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "minimum": {
                "type": ["string", "null"],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "maximum": {
                "type": ["string", "null"],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": ["field_type"],
                "properties": { "field_type": { "const": "TIME" } }
              },
              {
                "required": ["type"],
                "properties": { "type": { "const": "TIME" } }
              }
            ]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string",
                "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
              },
              "minimum": {
                "type": ["string", "null"],
                "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
              },
              "maximum": {
                "type": ["string", "null"],
                "pattern": "^\\d{2}:\\d{2}:\\d{2}$"
              }
